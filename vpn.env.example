# Configuration for vpn-strongswan.
#
# Copy to vpn.env, edit, then run `sudo ./install.sh`.
# install.sh resolves the blanks (interface, IPv6 pool) and writes the final
# values to /etc/vpn-strongswan.env, which every vpn-* script reads at runtime.

# --- required ---

# Public hostname of the VPN server. An A record (and AAAA, if the server has
# IPv6) must already point at this machine: Let's Encrypt validates over it,
# and clients match it against the certificate as their "Remote ID".
DOMAIN=vpn.example.com

# Address Let's Encrypt uses for expiry warnings.
LE_EMAIL=you@example.com

# --- optional: leave blank to autodetect ---

# WAN interface traffic is NAT'ed out of. Blank = taken from the default route.
WAN_IF=

# IPv4 address pool handed to clients. Must not overlap anything the clients
# use at home; 10.10.10.0/24 is a deliberately unusual choice for that reason.
POOL4=10.10.10.0/24

# IPv6 ULA pool, NAT66'ed to the server's global address. Blank = a random
# fd00::/8 prefix is generated at install time (do not reuse one across servers).
POOL6=

# 1 / 0 / auto. auto = enabled when the WAN interface has a global IPv6 address.
# Handing out IPv6 stops clients from leaking v6 traffic around the tunnel.
ENABLE_IPV6=auto

# DNS servers pushed to clients.
DNS4="1.1.1.1, 8.8.8.8"
DNS6="2606:4700:4700::1111, 2001:4860:4860::8888"

# Name shown on the client device for generated Apple profiles.
VPN_NAME=MyVPN

# Language of the credentials block printed by `vpn-user add|show`: en or ru.
CREDS_LANG=en

# --- optional: HTTP proxy for selective routing ---

# 1 / 0. Installs tinyproxy alongside the VPN. Where the VPN carries everything,
# this carries only what a client chooses to send through it -- useful for
# routing a few sites through this server while the VPN is off.
#
# It binds to loopback and is reached over an SSH tunnel, so enabling it opens
# no new port to the internet.
ENABLE_PROXY=0

# Port tinyproxy listens on, on 127.0.0.1 of this server.
PROXY_PORT=8888

# Public key permitted to open that tunnel, as a full line, e.g.
#   PROXY_SSH_KEY="ssh-ed25519 AAAAC3Nza... laptop"
# It is authorized for port-forwarding to the proxy alone: no shell, no command
# execution. Leave blank and add keys later with `vpn-proxy key add`.
PROXY_SSH_KEY=
