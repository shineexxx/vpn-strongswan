# IKEv2 / IPsec road-warrior server -- rendered by install.sh, edits are kept.
# Server auth: Let's Encrypt certificate  |  Client auth: EAP-MSCHAPv2 (login/password)
# Users are defined in conf.d/users.conf, generated by `vpn-user`.
# The certificate is deployed by /etc/letsencrypt/renewal-hooks/deploy/10-strongswan.sh

connections {

    ikev2-eap {
        version = 2
        # %any rather than a literal address, so the config survives the server
        # changing IP and works unchanged behind a 1:1 NAT.
        local_addrs = %any

        # Strongest first: the responder picks the earliest entry the client can
        # do, so weak tail entries are only ever used by clients with nothing
        # better. The MODP_1024 group is 1024-bit DH, weak against a
        # well-resourced attacker (Logjam) -- it is here solely because the
        # built-in Windows client offers no other group by default.
        proposals = aes256gcm16-prfsha384-ecp384,aes256gcm16-prfsha256-ecp256,aes256gcm16-prfsha384-modp3072,aes256gcm16-prfsha256-modp2048,aes256-sha384-ecp384,aes256-sha384-modp3072,aes256-sha256-modp3072,aes256-sha256-modp2048,aes256-sha1-modp2048,aes256gcm16-prfsha384-modp1024,aes256gcm16-prfsha256-modp1024,aes256-sha384-modp1024,aes256-sha256-modp1024

        # Never initiate IKE_SA rekey or reauth from the server side.
        #
        # Road-warrior clients sit behind NAT and sleep. They answer DPD
        # (which they treat as liveness) but routinely ignore a
        # server-initiated IKE_SA rekey. charon then hits "giving up after
        # 5 retransmits" -> "rekeying IKE_SA failed, peer not responding",
        # releases the leases and tears the SA down -- while the client still
        # believes the tunnel is up, so its traffic black-holes until the user
        # reconnects by hand.
        #
        # Clients drive their own rekey/reauth and the server answers.
        rekey_time = 0
        reauth_time = 0

        # Do not poll clients with DPD either.
        #
        # With dpd_delay = 30s the server probed every SA twice a minute and
        # destroyed any that missed the exchange (~15s of silence was enough):
        #   sending DPD request / giving up after 5 retransmits
        #   lease 10.10.10.4 by 'someone' went offline
        # Phones and laptops go quiet the moment the screen sleeps, so this was
        # tearing down perfectly healthy tunnels -- 139 teardowns in one day for
        # ~5 devices. The client never notices and keeps showing "connected"
        # while its traffic goes nowhere.
        #
        # As a responder the server has no need to poll: it answers DPD from
        # clients that ask. Trade-off: nothing on the server reaps SAs whose
        # client vanished without a DELETE -- that is what vpn-reap.timer is for.
        dpd_delay = 0

        fragmentation = yes
        # Always wrap ESP in UDP/4500: many public networks drop raw ESP (proto 50).
        encap = yes
        mobike = yes
        send_cert = always
        # Clients authenticate with EAP, never with a certificate, so asking
        # them for one only bloats IKE_SA_INIT with the public CA list.
        send_certreq = no
        # Allow the same login to be connected from several devices at once.
        # Set to `replace` if every device has its own credential -- then a
        # reconnecting device displaces its own stale session.
        unique = never
        pools = @POOLS@

        local {
            auth = pubkey
            certs = server-cert.pem
            id = @DOMAIN@
        }

        remote {
            auth = eap-mschapv2
            eap_id = %any
        }

        children {
            net {
                # Full tunnel: everything goes through the VPN.
                local_ts = 0.0.0.0/0, ::/0
                # Entries with a DH group answer clients that request PFS;
                # the bare ones answer clients that do not.
                esp_proposals = aes256gcm16-ecp384,aes256gcm16-modp3072,aes256gcm16-modp2048,aes256gcm16,aes256-sha256-modp3072,aes256-sha256-modp2048,aes256-sha256,aes128-sha256,aes256-sha1,aes128-sha1,aes256gcm16-modp1024,aes256-sha256-modp1024
                rekey_time = 1h
                dpd_action = clear
                start_action = none
            }
        }
    }
}

pools {
    pool-v4 {
        addrs = @POOL4@
        dns = @DNS4@
    }
    pool-v6 {
        # ULA range, NAT66'ed to the server's global IPv6 on egress.
        addrs = @POOL6@
        dns = @DNS6@
    }
}
