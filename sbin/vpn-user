#!/bin/bash
# Manage IKEv2 EAP-MSCHAPv2 users.
#
# Source of truth is /etc/swanctl/vpn-users (one "name:password" per line).
# /etc/swanctl/conf.d/users.conf is regenerated from it and reloaded into charon.
set -eu

. /etc/vpn-strongswan.env

DB=/etc/swanctl/vpn-users
OUT=/etc/swanctl/conf.d/users.conf
SWANCTL=/usr/sbin/swanctl
SASPARSE=/usr/local/libexec/vpn-sas.py
SERVER="$DOMAIN"

umask 077
[ -f "$DB" ] || : > "$DB"
chmod 600 "$DB"

usage() {
    cat <<EOF
Usage:
  vpn-user add <name> [password]    add a user (password generated if omitted)
  vpn-user passwd <name> [password] change a user's password
  vpn-user del <name>               remove a user
  vpn-user list                     list users
  vpn-user show <name>              show one user's credentials
  vpn-user who                      who is connected right now, by name
  vpn-user reload                   rebuild users.conf from $DB and reload charon
EOF
    exit 1
}

die() { echo "error: $*" >&2; exit 1; }

valid_name() { [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]]; }

# Backslash and double quote would break the swanctl.conf string literal.
valid_pass() { [[ "$1" != *'"'* && "$1" != *'\'* && -n "$1" ]]; }

gen_pass() { head -c 32 /dev/urandom | base64 | tr -d '/+=' | head -c 20; }

# Prints a block meant to be pasted straight into a message to the person who
# will use the account -- they are the audience, not the operator. Set
# CREDS_LANG in /etc/vpn-strongswan.env to pick the language.
creds() {
    if [ "${CREDS_LANG:-en}" = ru ]; then
        cat <<EOF

  Подключение к VPN
  -----------------
  Тип:        IKEv2 / IPsec
  Сервер:     $SERVER
  Remote ID:  $SERVER
  Local ID:   оставить пустым
  Логин:      $1
  Пароль:     $2

  iPhone:   Настройки > VPN > Добавить конфигурацию > IKEv2
  Android:  Настройки > VPN > + > IKEv2/IPSec MSCHAPv2
  Windows:  Параметры > VPN > Добавить > IKEv2, вход по имени и паролю
  macOS:    Системные настройки > VPN > Добавить > IKEv2

  Устанавливать на устройство ничего не нужно.
EOF
    else
        cat <<EOF

  VPN connection
  --------------
  Type:       IKEv2 / IPsec
  Server:     $SERVER
  Remote ID:  $SERVER
  Local ID:   leave empty
  Username:   $1
  Password:   $2

  iPhone:   Settings > General > VPN > Add VPN Configuration > IKEv2
  Android:  Settings > Network & internet > VPN > + > IKEv2/IPSec MSCHAPv2
  Windows:  Settings > Network & Internet > VPN > Add, type IKEv2,
            sign-in info "User name and password"
  macOS:    System Settings > VPN > Add VPN Configuration > IKEv2

  Nothing needs to be installed on the device.
EOF
    fi
}

exists() { grep -q "^$1:" "$DB"; }

# Rebuild users.conf from the database and push it into the running daemon.
regen() {
    local n=0 u p
    {
        echo "# Generated by vpn-user -- do not edit by hand."
        echo "# Edit $DB, then run 'vpn-user reload'."
        echo "secrets {"
        while IFS=: read -r u p; do
            [ -n "$u" ] || continue
            n=$((n + 1))
            printf '    eap-%d {\n        id = "%s"\n        secret = "%s"\n    }\n' "$n" "$u" "$p"
        done < "$DB"
        echo "}"
    } > "$OUT"
    chmod 600 "$OUT"
    "$SWANCTL" --load-creds >/dev/null
}

cmd="${1:-}"
[ -n "$cmd" ] || usage

case "$cmd" in
    add|passwd)
        name="${2:-}"; [ -n "$name" ] || usage
        valid_name "$name" || die "name may only contain letters, digits, . _ -"
        if [ "$cmd" = add ]; then
            exists "$name" && die "user '$name' already exists"
        else
            exists "$name" || die "no such user: $name"
        fi
        pass="${3:-$(gen_pass)}"
        valid_pass "$pass" || die 'password must be non-empty and contain no " or \'
        [ "$cmd" = passwd ] && sed -i "/^$name:/d" "$DB"
        printf '%s:%s\n' "$name" "$pass" >> "$DB"
        regen
        creds "$name" "$pass"
        ;;
    del)
        name="${2:-}"; [ -n "$name" ] || usage
        exists "$name" || die "no such user: $name"
        sed -i "/^$name:/d" "$DB"
        regen
        # Removing the secret does not drop an already-authenticated SA, so the
        # deleted user would stay online. Terminate only their sessions, by
        # unique IKE_SA id, so everyone else stays connected.
        n=0
        for id in $("$SWANCTL" --list-sas 2>/dev/null | "$SASPARSE" --ids "$name"); do
            "$SWANCTL" --terminate --ike-id "$id" --timeout 5 >/dev/null 2>&1 || true
            n=$((n + 1))
        done
        echo "removed: $name ($n active session(s) disconnected, other users untouched)"
        ;;
    reload)
        regen
        echo "reloaded"
        ;;
    list)
        printf '%-24s %s\n' "USER" "PASSWORD"
        while IFS=: read -r u p; do
            [ -n "$u" ] || continue
            printf '%-24s %s\n' "$u" "$p"
        done < "$DB"
        ;;
    who)
        "$SWANCTL" --list-sas 2>/dev/null | "$SASPARSE" --who
        ;;
    show)
        name="${2:-}"; [ -n "$name" ] || usage
        exists "$name" || die "no such user: $name"
        pass=$(awk -F: -v u="$name" '$1==u {print $2; exit}' "$DB")
        creds "$name" "$pass"
        ;;
    *)
        usage
        ;;
esac
